.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.env
.claude/estado/
.claude/settings.local.json
# Los informes del arnes de evals: salida de una ejecucion, no codigo. El
# directorio se versiona (evals/resultados/.gitkeep); su contenido no.
evals/resultados/*.json
# Los CSV de locust, por la misma razon y con la misma forma: el directorio se
# versiona (perf/resultados/.gitkeep) y los numeros reales quedan pegados en
# perf/MEDICION.md, que si se versiona.
perf/resultados/*.csv

# Los logs JSON del staging local: una linea por trabajo cerrado y las del
# adaptador del proveedor. Son salida de una corrida, y su retencion es pregunta
# abierta de F12 (decide Priya): fuera del repo. El directorio se versiona
# (staging/logs/.gitkeep); su contenido no.
staging/logs/*.jsonl
