# Variables de entorno de Criba. Copia a `.env` y rellena; `.env` está ignorado.
#
# Ninguna clave del proveedor de modelos vive en el repo (F19): cuando llegue
# (PR-09), su variable se añade AQUÍ como nombre, nunca con su valor.

CRIBA_URL_BD=postgresql+pg8000://criba:criba@localhost:5434/criba_dev
CRIBA_URL_BD_TEST=postgresql+pg8000://criba:criba@localhost:5434/criba_test

# Obligatoria en producción. El valor por omisión solo sirve en desarrollo.
CRIBA_SECRETO_SESION=cambia-esto-por-algo-aleatorio
