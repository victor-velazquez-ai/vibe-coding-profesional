# Copia este archivo a .env y rellena los valores.
# Atajo: `uv run poe init-env` lo hace por ti y genera un SECRET_KEY aleatorio.
# .env esta en .gitignore: nunca subas secretos al repo.

# --- Postgres (lo consumen docker-compose.yml y la app) ---
POSTGRES_USER=taller
POSTGRES_PASSWORD=
POSTGRES_DB=taller
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# --- Tokens ---
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Servidor de desarrollo ---
APP_HOST=127.0.0.1
APP_PORT=8000

# --- Logs ---
LOG_LEVEL=INFO
