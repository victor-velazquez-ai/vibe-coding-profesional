{
  "permissions": {
    "allow": [
      "Bash(uv run poe:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run alembic:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(uv sync:*)",
      "Bash(uv add:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git switch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git add:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git branch:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run watch:*)",
      "Bash(curl:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ],
    "ask": [
      "Bash(docker:*)",
      "Bash(uv run alembic downgrade:*)",
      "Bash(gh pr merge:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(cat .env:*)",
      "Bash(git push --force:*)",
      "Bash(rm -rf:*)",
      "Bash(git push origin main:*)",
      "Bash(git push -f:*)",
      "Bash(gh pr merge --admin:*)",
      "Bash(gh api:*)",
      "Bash(gh repo:*)",
      "Bash(gh secret:*)",
      "Bash(docker exec:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet python \"$CLAUDE_PROJECT_DIR/.claude/hooks/proteger_tests.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet python \"$CLAUDE_PROJECT_DIR/.claude/hooks/formatear.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet python \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_antes_de_terminar.py\"",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
